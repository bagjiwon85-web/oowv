[
 {
  "start": 0.0,
  "end": 2.76,
  "text": "사람들은 딱 세 가지의 돈을 씁니다"
 },
 {
  "start": 2.76,
  "end": 6.48,
  "text": "첫째, 자신의 고통을 없애기 위해 지갑을 엽니다"
 },
 {
  "start": 6.48,
  "end": 10.76,
  "text": "스트레스, 빛, 체중 등 문제가 클수록 더 많은 돈을 쓰죠"
 },
 {
  "start": 10.76,
  "end": 14.72,
  "text": "스트레스를 해소하기 위해 쇼핑을 하거나 살이 쪄서"
 },
 {
  "start": 14.72,
  "end": 17.2,
  "text": "다이어트하기 위해 돈을 쓰는 것처럼요"
 },
 {
  "start": 17.2,
  "end": 20.72,
  "text": "둘째, 삼성, 애플, 쿠팡, 아마존 등"
 },
 {
  "start": 20.72,
  "end": 22.8,
  "text": "세계적인 기업들의 공통점은"
 },
 {
  "start": 22.8,
  "end": 27.32,
  "text": "더 빠르게, 더 쉽게, 편리하게 해 주는 것들을 판다는 겁니다"
 },
 {
  "start": 27.36,
  "end": 30.24,
  "text": "사람들이 자신의 귀찮음을 해소해줄 때"
 },
 {
  "start": 30.24,
  "end": 32.72,
  "text": "돈을 쓴다는 걸 알고 있기 때문이죠"
 },
 {
  "start": 32.72,
  "end": 36.24,
  "text": "셋째, 다른 데서 얻을 수 없는 그 순간의 감정"
 },
 {
  "start": 36.24,
  "end": 38.64,
  "text": "나중에 할 얘기거리에 돈을 씁니다"
 },
 {
  "start": 38.64,
  "end": 41.72,
  "text": "편의점 봉투값 100원은 아까워서 손에 들고 가면서"
 },
 {
  "start": 41.72,
  "end": 44.8,
  "text": "해외여행엔 100만원을 턱턱 쓰는 이유죠"
 },
 {
  "start": 44.8,
  "end": 47.36,
  "text": "돈은 이 세 군데로만 흐릅니다"
 },
 {
  "start": 47.36,
  "end": 51.08,
  "text": "돈을 버는 사람은 이 세 중 하나를 주는 사람이라는 말이죠"
 },
 {
  "start": 51.08,
  "end": 55.2,
  "text": "그렇다면 나는 이 세 중에 뭘 줄 수 있는 사람일까요?"
 },
 {
  "start": 55.2,
  "end": 59.16,
  "text": "질문 몇 개만 답하면 알 수 있게 준비해놨습니다"
 },
 {
  "start": 59.16,
  "end": 61.36,
  "text": "프로필링크에서 확인해보세요"
 }
]