[{"i": 0, "text": "우리는 보통 부자가 되고 싶을 때", "start": 0.0, "end": 2.8, "voiced": [[0.349, 2.402]]}, {"i": 1, "text": "어떻게 하면 돈을 더 많이 벌 수 있을지부터 고민합니다", "start": 2.8, "end": 6.2, "voiced": [[3.009, 5.846]]}, {"i": 2, "text": "월급을 높이거나, 일을 더 많이 하거나,", "start": 6.2, "end": 8.7, "voiced": [[6.319, 8.427]]}, {"i": 3, "text": "좋은 투자처를 찾는 방법을 알아보죠", "start": 8.7, "end": 11.0, "voiced": [[8.915, 10.726]]}, {"i": 4, "text": "물론 돈을 많이 버는 것도 중요합니다", "start": 11.0, "end": 13.1, "voiced": [[11.24, 12.855]]}, {"i": 5, "text": "하지만 수입이 늘어난다고", "start": 13.1, "end": 14.9, "voiced": [[13.245, 14.69]]}, {"i": 6, "text": "반드시 부자가 되는 건 아닙니다", "start": 14.9, "end": 16.9, "voiced": [[15.113, 16.685]]}, {"i": 7, "text": "돈을 많이 벌어도 정작 원하는 삶과는 멀어질 수 있고,", "start": 16.9, "end": 20.4, "voiced": [[17.032, 18.04], [18.215, 20.091]]}, {"i": 8, "text": "지금 하는 일에만 집중하느라", "start": 20.4, "end": 22.5, "voiced": [[20.591, 22.132]]}, {"i": 9, "text": "새로운 수입을 만들 기회를 놓칠 수도 있기 때문입니다", "start": 22.5, "end": 26.0, "voiced": [[22.615, 24.235], [24.375, 25.705]]}, {"i": 10, "text": "심지어 좋은 능력을 갖추고 있어도", "start": 26.0, "end": 28.9, "voiced": [[26.335, 28.439]]}, {"i": 11, "text": "그 능력으로 돈을 버는 방법을 모를 수도 있죠", "start": 28.9, "end": 31.4, "voiced": [[29.057, 31.268]]}, {"i": 12, "text": "그렇다면 부자가 되기 위해 우리는 무엇을 다르게 준비해야 할까요?", "start": 31.4, "end": 35.7, "voiced": [[31.805, 33.471], [33.591, 35.341]]}, {"i": 13, "text": "오늘은 부자가 되고 싶다면", "start": 35.7, "end": 38.2, "voiced": [[35.951, 36.494], [36.624, 37.71]]}, {"i": 14, "text": "반드시 알아야 할 세 가지를 이야기해 보겠습니다", "start": 38.2, "end": 40.8, "voiced": [[38.393, 40.456]]}, {"i": 15, "text": "이 영상을 끝까지 보시면", "start": 40.8, "end": 42.4, "voiced": [[40.919, 42.26]]}, {"i": 16, "text": "지금 내가 무엇을 놓치고 있는지,", "start": 42.4, "end": 44.8, "voiced": [[42.713, 44.426]]}, {"i": 17, "text": "그리고 경제적으로 더 나은 삶을 위해", "start": 44.8, "end": 47.4, "voiced": [[45.004, 45.894], [46.056, 47.12]]}, {"i": 18, "text": "무엇부터 바꿔야 할지 알게 되실 겁니다", "start": 47.4, "end": 49.7, "voiced": [[47.646, 49.416]]}, {"i": 19, "text": "첫 번째, 목표를 구체적으로 정해라", "start": 49.7, "end": 52.3, "voiced": [[49.895, 50.813], [50.968, 51.909]]}, {"i": 20, "text": "여러분은 왜 부자가 되고 싶으신가요?", "start": 52.3, "end": 54.6, "voiced": [[52.456, 54.197]]}, {"i": 21, "text": "\"돈이 많으면 좋잖아요\"", "start": 54.6, "end": 56.2, "voiced": [[54.786, 56.026]]}, {"i": 22, "text": "맞는 말입니다.", "start": 56.2, "end": 57.7, "voiced": [[56.462, 57.353]]}, {"i": 23, "text": "그런데 한 번만 더 생각해 보세요", "start": 57.7, "end": 60.5, "voiced": [[58.044, 58.509], [58.809, 60.01]]}, {"i": 24, "text": "돈이 많아지면 지금과 무엇이 달라졌으면 좋겠나요?", "start": 60.5, "end": 64.2, "voiced": [[60.832, 63.758]]}, {"i": 25, "text": "부모님께 생활비를 드리고 싶은 건가요?", "start": 64.2, "end": 66.5, "voiced": [[64.316, 66.018]]}, {"i": 26, "text": "가족과 여행을 가고 싶은 건가요?", "start": 66.5, "end": 68.6, "voiced": [[66.698, 68.209]]}, {"i": 27, "text": "일하는 시간을 줄이고 싶은 건가요?", "start": 68.6, "end": 70.7, "voiced": [[68.712, 70.184]]}, {"i": 28, "text": "이유가 달라지면 필요한 돈도, 준비할 일도 달라집니다", "start": 70.7, "end": 74.8, "voiced": [[71.018, 71.96], [72.303, 73.109], [73.304, 74.449]]}, {"i": 29, "text": "예를 들어 가족과 여행을 가고 싶다면", "start": 74.8, "end": 78.4, "voiced": [[75.285, 76.028], [76.334, 77.954]]}, {"i": 30, "text": "언제, 어디로 갈지 정할 수 있겠죠", "start": 78.4, "end": 81.1, "voiced": [[78.598, 79.039], [79.442, 80.763]]}, {"i": 31, "text": "그러면 얼마를 모아야 할지도 알아볼 수 있습니다", "start": 81.1, "end": 84.3, "voiced": [[81.499, 83.927]]}, {"i": 32, "text": "반대로 일하는 시간을 줄이고 싶다면", "start": 84.3, "end": 87.0, "voiced": [[84.485, 85.022], [85.286, 86.798]]}, {"i": 33, "text": "내가 덜 일해도 생활할 수 있는 방법을 고민해야 합니다", "start": 87.0, "end": 91.0, "voiced": [[87.207, 88.485], [88.892, 90.719]]}, {"i": 34, "text": "같은 \"돈을 더 벌고 싶다\"는 말이라도", "start": 91.0, "end": 93.5, "voiced": [[91.213, 93.128]]}, {"i": 35, "text": "실제로 해야 할 일은 다른 거예요", "start": 93.5, "end": 95.7, "voiced": [[93.706, 95.427]]}, {"i": 36, "text": "목표가 없으면", "start": 95.7, "end": 97.2, "voiced": [[95.899, 96.816]]}, {"i": 37, "text": "돈을 벌고도 계속 부족하다고 느낄 수 있습니다", "start": 97.2, "end": 100.1, "voiced": [[97.435, 99.871]]}, {"i": 38, "text": "오백만 원을 벌면 천만 원 버는 사람이 보이고,", "start": 100.1, "end": 103.6, "voiced": [[100.486, 103.156]]}, {"i": 39, "text": "천만 원을 벌면 그보다 많이 버는 사람이 눈에 들어옵니다", "start": 103.6, "end": 107.2, "voiced": [[103.757, 104.702], [104.852, 106.838]]}, {"i": 40, "text": "내가 원하는 삶을 모르니 남을 볼 때마다 목표가 바뀌는 거죠", "start": 107.2, "end": 111.1, "voiced": [[107.411, 108.687], [108.826, 110.773]]}, {"i": 41, "text": "특히 가족과 시간을 보내려고 돈을 벌기 시작했는데", "start": 111.1, "end": 114.4, "voiced": [[111.198, 113.922]]}, {"i": 42, "text": "돈을 더 벌수록 가족과 함께할 시간이 줄어든다면 어떨까요?", "start": 114.4, "end": 118.0, "voiced": [[114.793, 115.556], [115.704, 117.66]]}, {"i": 43, "text": "수입은 늘어도 처음 원했던 삶에서는 멀어집니다", "start": 118.0, "end": 121.4, "voiced": [[118.24, 119.127], [119.354, 121.185]]}, {"i": 44, "text": "그러니 \"얼마를 벌고 싶다\"와 함께", "start": 121.4, "end": 123.7, "voiced": [[121.742, 123.411]]}, {"i": 45, "text": "이 문장도 완성해 보세요", "start": 123.7, "end": 125.5, "voiced": [[123.96, 125.227]]}, {"i": 46, "text": "\"나는 돈을 벌어서 ○○하고 싶다\"", "start": 125.5, "end": 127.5, "voiced": [[125.732, 126.862], [126.986, 127.164]]}, {"i": 47, "text": "답이 구체적일수록 어떤 기회를 선택하고", "start": 127.5, "end": 130.8, "voiced": [[127.905, 128.921], [129.071, 130.368]]}, {"i": 48, "text": "어디에 시간과 돈을 쓸지 정하기 쉬워집니다", "start": 130.8, "end": 134.0, "voiced": [[131.054, 133.603]]}, {"i": 49, "text": "그런데 원하는 삶을 정했다고 해서 그 삶을 실현할 돈이 저절로 생기는 건 아닙니다", "start": 134.0, "end": 138.9, "voiced": [[134.245, 138.533]]}, {"i": 50, "text": "결국 필요한 돈을 벌 방법도 찾아야겠죠", "start": 138.9, "end": 141.6, "voiced": [[139.046, 141.137]]}, {"i": 51, "text": "그렇다면 지금 하는 일 외에 새로운 수입을 만들 방법은 없을까요?", "start": 141.6, "end": 145.6, "voiced": [[141.948, 145.382]]}, {"i": 52, "text": "두 번째, 다른 사람에게 필요한 가치를 찾아라", "start": 145.6, "end": 148.8, "voiced": [[145.943, 146.397], [146.66, 148.411]]}, {"i": 53, "text": "우리는 돈을 더 벌고 싶을 때", "start": 148.8, "end": 151.0, "voiced": [[149.05, 150.698]]}, {"i": 54, "text": "지금 하고 있는 일에서 답을 찾으려고 합니다", "start": 151.0, "end": 153.7, "voiced": [[151.253, 153.257]]}, {"i": 55, "text": "그런데 꼭 같은 방식으로만 돈을 벌어야 할까요?", "start": 153.7, "end": 156.9, "voiced": [[154.043, 156.521]]}, {"i": 56, "text": "예를 들어 빵집을 운영하는 사람이 있다고 해볼게요", "start": 156.9, "end": 160.0, "voiced": [[157.366, 159.611]]}, {"i": 57, "text": "이 사람은 매출을 높이려면", "start": 160.0, "end": 162.2, "voiced": [[160.398, 162.013]]}, {"i": 58, "text": "가게에 손님이 더 많이 와야 한다고 생각합니다", "start": 162.2, "end": 164.8, "voiced": [[162.47, 164.45]]}, {"i": 59, "text": "그런데 주변에는 집에서 빵을 만들고 싶은 사람도,", "start": 164.8, "end": 168.1, "voiced": [[164.956, 167.643]]}, {"i": 60, "text": "직원 간식으로 빵을 주문하려는 회사도 있습니다", "start": 168.1, "end": 170.7, "voiced": [[168.214, 170.521]]}, {"i": 61, "text": "그렇다면 제빵 수업을 열거나 단체 주문을 받을 수도 있겠죠", "start": 170.7, "end": 173.9, "voiced": [[170.95, 173.623]]}, {"i": 62, "text": "같은 빵 만드는 능력이라도", "start": 173.9, "end": 175.8, "voiced": [[173.991, 175.495]]}, {"i": 63, "text": "누구에게 무엇을 해주느냐에 따라 돈 버는 방법이 달라집니다", "start": 175.8, "end": 179.3, "voiced": [[176.023, 179.109]]}, {"i": 64, "text": "직장인도 마찬가지입니다", "start": 179.3, "end": 180.8, "voiced": [[179.505, 180.581]]}, {"i": 65, "text": "회사에서 엑셀로 자료를 정리하는 일은 내게 익숙하지만,", "start": 180.8, "end": 184.9, "voiced": [[181.112, 184.46]]}, {"i": 66, "text": "작은 가게 사장님에게 매출과 비용 정리는 큰 고민일 수 있어서", "start": 184.9, "end": 189.1, "voiced": [[185.131, 188.881]]}, {"i": 67, "text": "내가 쉽게 하는 일을 누군가는 어려워하는 겁니다.", "start": 189.1, "end": 192.4, "voiced": [[189.3, 190.535], [190.736, 192.062]]}, {"i": 68, "text": "즉, 내가 가진 능력이 누군가의 문제를 해결해 줄 때", "start": 192.4, "end": 196.1, "voiced": [[192.54, 192.7], [193.139, 194.175], [194.384, 195.895]]}, {"i": 69, "text": "그 능력은 돈을 벌 수 있는 가치가 되는 겁니다", "start": 196.1, "end": 199.1, "voiced": [[196.31, 198.8]]}, {"i": 70, "text": "그래서 새로운 기회를 찾으려면", "start": 199.1, "end": 201.2, "voiced": [[199.344, 200.765]]}, {"i": 71, "text": "\"뭘 해야 돈을 많이 벌까?\"라는 질문과", "start": 201.2, "end": 204.4, "voiced": [[201.425, 202.909], [203.106, 204.015]]}, {"i": 72, "text": "이런 질문을 해봐야 합니다", "start": 204.4, "end": 205.9, "voiced": [[204.509, 205.608]]}, {"i": 73, "text": "\"사람들은 어떤 일로 불편해할까?\"", "start": 205.9, "end": 208.0, "voiced": [[206.113, 207.745]]}, {"i": 74, "text": "\"그중에서 내가 도와줄 수 있는 건 뭘까?\"", "start": 208.0, "end": 210.8, "voiced": [[208.341, 210.256]]}, {"i": 75, "text": "평소와 다른 분야의 이야기를 들어보고,", "start": 210.8, "end": 213.3, "voiced": [[211.009, 212.997]]}, {"i": 76, "text": "다른 일을 하는 사람들의 고민도 살펴보세요", "start": 213.3, "end": 215.8, "voiced": [[213.459, 215.455]]}, {"i": 77, "text": "내게는 당연한 경험이", "start": 215.8, "end": 217.6, "voiced": [[216.066, 217.227]]}, {"i": 78, "text": "다른 사람에게는 필요한 도움일 수 있습니다", "start": 217.6, "end": 220.4, "voiced": [[217.837, 219.905]]}, {"i": 79, "text": "물론 아이디어가 떠올랐다고", "start": 220.4, "end": 222.4, "voiced": [[220.587, 222.057]]}, {"i": 80, "text": "바로 돈이 되는 건 아닙니다", "start": 222.4, "end": 224.1, "voiced": [[222.541, 223.774]]}, {"i": 81, "text": "필요로 하는 사람이 실제로 있는지,", "start": 224.1, "end": 226.2, "voiced": [[224.239, 225.76]]}, {"i": 82, "text": "돈을 낼 만큼 도움이 되는지 확인해야 합니다", "start": 226.2, "end": 228.5, "voiced": [[226.314, 228.17]]}, {"i": 83, "text": "중요한 건 지금 하는 일을 더 많이 하는 것만이", "start": 228.5, "end": 231.8, "voiced": [[228.631, 229.298], [229.544, 231.416]]}, {"i": 84, "text": "수입을 높이는 유일한 방법은 아니라는 겁니다", "start": 231.8, "end": 234.3, "voiced": [[231.898, 234.056]]}, {"i": 85, "text": "내가 이미 가지고 있는 능력으로도", "start": 234.3, "end": 236.5, "voiced": [[234.541, 236.24]]}, {"i": 86, "text": "새로운 수입을 만들 기회를 찾을 수 있습니다", "start": 236.5, "end": 239.4, "voiced": [[236.76, 237.55], [237.676, 239.129]]}, {"i": 87, "text": "그런데 새로운 방법을 발견해도", "start": 239.4, "end": 241.9, "voiced": [[239.566, 240.066], [240.347, 241.62]]}, {"i": 88, "text": "생각만으로는 돈을 벌 수 없습니다", "start": 241.9, "end": 244.1, "voiced": [[242.083, 243.688]]}, {"i": 89, "text": "직접 해보면서 가능성을 확인해야 하죠", "start": 244.1, "end": 246.8, "voiced": [[244.271, 246.632]]}, {"i": 90, "text": "그 과정에서 새로운 것을 배우거나", "start": 246.8, "end": 249.3, "voiced": [[247.128, 247.793], [248.019, 249.086]]}, {"i": 91, "text": "상품을 만들어보는 데 돈이 필요할 수 있습니다", "start": 249.3, "end": 251.9, "voiced": [[249.507, 250.532], [250.686, 251.576]]}, {"i": 92, "text": "그래서 앞서 말씀드린 것처럼", "start": 251.9, "end": 253.8, "voiced": [[252.058, 253.515]]}, {"i": 93, "text": "기회를 시도할 수 있는 돈을 준비해두는 것도 중요합니다", "start": 253.8, "end": 256.7, "voiced": [[253.903, 256.212]]}, {"i": 94, "text": "하지만 필요한 돈과 아이디어가 준비됐다고 해서", "start": 256.7, "end": 259.7, "voiced": [[256.797, 259.379]]}, {"i": 95, "text": "그 능력이 저절로 수입이 되는 건 아닙니다", "start": 259.7, "end": 262.2, "voiced": [[259.896, 261.808]]}, {"i": 96, "text": "내가 가진 가치를 필요한 사람에게 알리고,", "start": 262.2, "end": 265.1, "voiced": [[262.454, 264.748]]}, {"i": 97, "text": "실제로 돈을 벌 수 있는 방법도 알아야 합니다", "start": 265.1, "end": 267.8, "voiced": [[265.253, 267.438]]}, {"i": 98, "text": "세 번째, 가치를 돈으로 바꾸는 기술을 배워라", "start": 267.8, "end": 270.8, "voiced": [[268.092, 270.517]]}, {"i": 99, "text": "여기서 한 가지 알아야 할 점이 있습니다", "start": 270.8, "end": 272.9, "voiced": [[271.004, 272.647]]}, {"i": 100, "text": "일을 잘하는 것과", "start": 272.9, "end": 274.5, "voiced": [[273.112, 274.112]]}, {"i": 101, "text": "그 능력으로 돈을 버는 것은 다르다는 겁니다", "start": 274.5, "end": 277.3, "voiced": [[274.597, 277.006]]}, {"i": 102, "text": "좋은 능력이 있어도 필요한 사람을 찾지 못하면", "start": 277.3, "end": 280.9, "voiced": [[277.645, 278.766], [278.909, 280.388]]}, {"i": 103, "text": "실제 수입으로 이어지기 어렵습니다", "start": 280.9, "end": 283.1, "voiced": [[280.967, 282.848]]}, {"i": 104, "text": "그러니 무조건 더 일하기보다", "start": 283.1, "end": 285.0, "voiced": [[283.27, 284.65]]}, {"i": 105, "text": "내게 부족한 것이 무엇인지 살펴보세요", "start": 285.0, "end": 287.6, "voiced": [[285.156, 287.138]]}, {"i": 106, "text": "사람들에게 나를 알리는 방법인지,", "start": 287.6, "end": 290.0, "voiced": [[287.665, 289.659]]}, {"i": 107, "text": "내 능력을 설명하는 방법인지,", "start": 290.0, "end": 292.2, "voiced": [[290.125, 291.862]]}, {"i": 108, "text": "사람들이 무엇을 필요로 하는지 알아보는 방법인지", "start": 292.2, "end": 295.4, "voiced": [[292.397, 294.928]]}, {"i": 109, "text": "부족한 것을 배워 작게 시도하고,", "start": 295.4, "end": 297.8, "voiced": [[295.57, 296.482], [296.612, 297.518]]}, {"i": 110, "text": "사람들의 반응을 살펴 고쳐 나가는 겁니다", "start": 297.8, "end": 300.7, "voiced": [[298.004, 299.269], [299.426, 300.344]]}, {"i": 111, "text": "예를 들어 내 능력을 알리는 방법이 부족하다면", "start": 300.7, "end": 303.7, "voiced": [[300.793, 301.363], [301.566, 303.504]]}, {"i": 112, "text": "콘텐츠를 활용해 볼 수 있습니다", "start": 303.7, "end": 305.5, "voiced": [[303.743, 305.257]]}, {"i": 113, "text": "내 지식과 기술로 사람들의 문제를 해결하는 방법을", "start": 305.5, "end": 308.8, "voiced": [[305.631, 308.556]]}, {"i": 114, "text": "콘텐츠로 보여주는 것이죠", "start": 308.8, "end": 310.4, "voiced": [[308.863, 310.199]]}, {"i": 115, "text": "그중 하나가 바로 유튜브입니다", "start": 310.4, "end": 312.3, "voiced": [[310.522, 312.025]]}, {"i": 116, "text": "자신의 지식과 경험을 공유해 필요한 사람들의 관심을 모으고,", "start": 312.3, "end": 316.1, "voiced": [[312.517, 315.86]]}, {"i": 117, "text": "더 구체적인 도움을 원하는 사람에게", "start": 316.1, "end": 318.7, "voiced": [[316.357, 318.238]]}, {"i": 118, "text": "관련 상품이나 서비스를 제공할 수 있습니다", "start": 318.7, "end": 321.4, "voiced": [[318.767, 321.117]]}, {"i": 119, "text": "실제로 30대 주부는 자신의 지식과 경험을 콘텐츠로 알리고", "start": 321.4, "end": 325.9, "voiced": [[321.655, 323.075], [323.369, 325.565]]}, {"i": 120, "text": "그 정보가 필요한 사람들을 모아 1억 원의 매출을 만들었습니다", "start": 325.9, "end": 329.9, "voiced": [[326.015, 327.755], [327.988, 329.593]]}, {"i": 121, "text": "그런데 여기서 중요한 점이 있습니다", "start": 329.9, "end": 332.2, "voiced": [[330.058, 331.848]]}, {"i": 122, "text": "유튜브에 콘텐츠를 올리고 사람들의 관심을 모았다고 해서", "start": 332.2, "end": 336.0, "voiced": [[332.434, 333.722], [334.173, 335.803]]}, {"i": 123, "text": "반드시 수익으로 이어지는 건 아니라는 겁니다", "start": 336.0, "end": 338.4, "voiced": [[336.114, 338.144]]}, {"i": 124, "text": "누구를 대상으로 콘텐츠를 만들지,", "start": 338.4, "end": 340.7, "voiced": [[338.608, 340.497]]}, {"i": 125, "text": "어떤 상품이나 서비스를 제공할지,", "start": 340.7, "end": 342.9, "voiced": [[340.741, 342.644]]}, {"i": 126, "text": "그 관심을 어떻게 구매로 연결할지까지 생각해야 합니다", "start": 342.9, "end": 346.2, "voiced": [[343.042, 345.755]]}, {"i": 127, "text": "그런데 막상 유튜브로 사업을 시작하려고 하면", "start": 346.2, "end": 349.5, "voiced": [[346.5, 346.968], [347.117, 349.025]]}, {"i": 128, "text": "내가 가진 경험 중 무엇을 활용해야 할지,", "start": 349.5, "end": 352.1, "voiced": [[349.648, 351.627]]}, {"i": 129, "text": "어떤 콘텐츠부터 만들어야 할지", "start": 352.1, "end": 354.1, "voiced": [[352.333, 353.867]]}, {"i": 130, "text": "막막할 수 있습니다", "start": 354.1, "end": 355.6, "voiced": [[354.213, 355.145]]}, {"i": 131, "text": "사람마다 가진 지식과 경험도,", "start": 355.6, "end": 357.8, "voiced": [[355.852, 357.521]]}, {"i": 132, "text": "현재 준비된 것도 다르기 때문이죠", "start": 357.8, "end": 359.8, "voiced": [[357.948, 359.476]]}, {"i": 133, "text": "그래서 무작정 영상을 만들기보다", "start": 359.8, "end": 362.3, "voiced": [[360.084, 362.127]]}, {"i": 134, "text": "지금 내 상황에서 무엇부터 준비해야 할지", "start": 362.3, "end": 364.8, "voiced": [[362.502, 364.497]]}, {"i": 135, "text": "먼저 확인해 보는 게 좋습니다", "start": 364.8, "end": 366.5, "voiced": [[364.914, 366.28]]}, {"i": 136, "text": "고정 댓글에 이를 확인할 수 있는 링크를 남겨두었습니다", "start": 366.5, "end": 369.6, "voiced": [[366.637, 369.358]]}, {"i": 137, "text": "링크에서 질문에 답하고 신청까지 완료하시면", "start": 369.6, "end": 372.9, "voiced": [[369.878, 372.437]]}, {"i": 138, "text": "여러분의 응답을 바탕으로 한 기초 진단표를 받아보실 수 있습니다", "start": 372.9, "end": 376.5, "voiced": [[372.954, 376.075]]}, {"i": 139, "text": "유튜브로 수익을 만들고 싶은데", "start": 376.5, "end": 378.7, "voiced": [[376.662, 378.288]]}, {"i": 140, "text": "무엇부터 시작해야 할지 막막하셨다면,", "start": 378.7, "end": 381.5, "voiced": [[378.927, 381.08]]}, {"i": 141, "text": "지금 고정 댓글 링크에서", "start": 381.5, "end": 383.3, "voiced": [[381.565, 383.057]]}, {"i": 142, "text": "내 상황부터 확인해 보세요", "start": 383.3, "end": 385.3, "voiced": [[383.513, 384.799]]}]